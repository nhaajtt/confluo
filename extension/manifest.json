{
  "manifest_version": 3,
  "name": "Confluo",
  "version": "0.1.0",
  "description": "Send downloads to the Confluo download manager on this computer.",
  "minimum_chrome_version": "121",
  "permissions": ["downloads", "storage", "contextMenus"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js", "scripts": ["background.js"]},
  "options_ui": {"page": "options.html", "open_in_tab": false},
  "action": {"default_title": "Confluo", "default_popup": "options.html"},
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"},
  "browser_specific_settings": {"gecko": {"id": "confluo@nhaajt.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}},
  "homepage_url": "https://confluo.nhaajt.com"
}
